<Window x:Class="CastoPet.Presentation.Windows.CrashNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CastoPet"
        Icon="/CastoPet;component/Assets/AppIcon.ico"
        Width="430"
        Height="230"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="MiSans, Noto Sans SC, Microsoft YaHei UI">
    <Border Margin="14"
            Padding="26,22"
            CornerRadius="8"
            Background="#FAF9FC"
            BorderBrush="#E2DCE7"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.16" Color="#51475D" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="上次运行发生异常"
                       FontSize="18"
                       FontWeight="Medium"
                       Foreground="#35313A" />
            <TextBlock Grid.Row="1"
                       Margin="0,12,0,14"
                       Text="CastoPet 已在本机保存崩溃日志。日志不会自动发送，你可以打开目录查看。"
                       TextWrapping="Wrap"
                       FontSize="12.5"
                       LineHeight="21"
                       Foreground="#7A7480" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="92"
                        Height="34"
                        Margin="0,0,10,0"
                        Padding="14,0"
                        Content="打开日志目录"
                        Background="#8C7AA5"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OpenReportsButton_Click" />
                <Button MinWidth="68"
                        Height="34"
                        Padding="14,0"
                        Content="忽略"
                        Background="#F0ECF3"
                        Foreground="#57515D"
                        BorderBrush="#E1DAE6"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="IgnoreButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
