<Window x:Class="CastoPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CastoPet 设置"
        Width="500"
        Height="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="MiSans, Noto Sans SC, Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PurpleBrush" Color="#8C7AA5" />
        <SolidColorBrush x:Key="PurpleHoverBrush" Color="#7E6D97" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FAF9FC" />
        <SolidColorBrush x:Key="LavenderBrush" Color="#F4F1F7" />
        <SolidColorBrush x:Key="DividerBrush" Color="#E7E0EC" />
        <SolidColorBrush x:Key="TextBrush" Color="#35313A" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#7A7480" />

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22">
                            <Border x:Name="Track"
                                    CornerRadius="11"
                                    Background="#DDD9E1"
                                    BorderBrush="#D2CDD6"
                                    BorderThickness="1" />
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.14" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#8C7AA5" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#8C7AA5" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#B7A9C8" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#716A78" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseButtonSurface"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseButtonSurface" Property="Background" Value="#EEE9F2" />
                                <Setter Property="Foreground" Value="#554C5E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseButtonSurface" Property="Background" Value="#E5DDEB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="#EEE9F2" />
            <Setter Property="Foreground" Value="#5F5668" />
            <Setter Property="BorderBrush" Value="#DED6E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Border Margin="14"
            CornerRadius="8"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="#E2DCE7"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.16" Color="#51475D" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="设置"
                               FontSize="20"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="调整 CastoPet 的行为与系统选项"
                               Margin="0,3,0,0"
                               FontSize="11.5"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Style="{StaticResource CloseButtonStyle}"
                        Content="×"
                        FontSize="20"
                        ToolTip="关闭"
                        Click="CloseButton_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,0,18,12">
                    <StackPanel x:Name="SettingsItemsHost" />

                    <Border Margin="0,6,0,0"
                            Padding="11,7"
                            Background="{StaticResource LavenderBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="维护"
                                   FontSize="12.5"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource PurpleBrush}" />
                    </Border>

                    <Grid MinHeight="64" Margin="11,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="本地崩溃日志"
                                       FontSize="13.5"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="查看仅保存在此电脑上的异常报告"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Button x:Name="OpenCrashReportsButton"
                                Grid.Column="1"
                                Style="{StaticResource ActionButtonStyle}"
                                Content="打开目录"
                                Click="OpenCrashReportsButton_Click" />
                    </Grid>

                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                        <Grid MinHeight="82" Margin="11,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="自动更新"
                                           FontSize="13.5"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="CurrentVersionText"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="UpdateStatusText"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button x:Name="CheckForUpdatesButton"
                                    Grid.Column="1"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Content="检查更新"
                                    Click="CheckForUpdatesButton_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource LavenderBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
                <TextBlock Margin="24,0"
                           VerticalAlignment="Center"
                           Text="更改将立即生效并自动保存"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </Border>
        </Grid>
    </Border>
</Window>
