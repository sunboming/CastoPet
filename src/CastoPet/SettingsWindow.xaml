<Window x:Class="CastoPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CastoPet 设置" Width="840" Height="680" MinWidth="760" MaxWidth="920" MinHeight="600"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="Transparent"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        FontFamily="MiSans, Noto Sans SC, Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowTintBrush" Color="#DCF8F5FB" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FAF9FC" />
        <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#EFFFFFFF" />
        <SolidColorBrush x:Key="LavenderBrush" Color="#BEF4F1F7" />
        <SolidColorBrush x:Key="NavigationBrush" Color="#98DCC9EE" />
        <SolidColorBrush x:Key="DividerBrush" Color="#AAE7E0EC" />
        <SolidColorBrush x:Key="BorderBrush" Color="#BEDED3E8" />
        <SolidColorBrush x:Key="TextBrush" Color="#35313A" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#7A7480" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#8C7AA5" />
        <SolidColorBrush x:Key="PurpleHoverBrush" Color="#7E6D97" />
        <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#DCEEE9F2" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#EEE5DCED" />
        <SolidColorBrush x:Key="InputBrush" Color="#EBFFFFFF" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#CDEBE2F3" />
        <SolidColorBrush x:Key="ToggleTrackBrush" Color="#D5CFDA" />
        <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#A14F62" />
        <SolidColorBrush x:Key="ShadowBrush" Color="#6451475D" />
        <SolidColorBrush x:Key="GlassHighlightBrush" Color="#BEFFFFFF" />
        <SolidColorBrush x:Key="FrostedGrainBrush" Color="#36463452" />
        <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#58FFFFFF" />
            <GradientStop Offset="0.36" Color="#18FFFFFF" />
            <GradientStop Offset="1" Color="#209A73B8" />
        </LinearGradientBrush>
        <DrawingBrush x:Key="FrostedTextureBrush" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#48FFFFFF" Geometry="M 1,2 L 2,2 2,3 1,3 Z" />
                    <GeometryDrawing Brush="#30FFFFFF" Geometry="M 8,5 L 9,5 9,6 8,6 Z" />
                    <GeometryDrawing Brush="{DynamicResource FrostedGrainBrush}" Geometry="M 4,9 L 5,9 5,10 4,10 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="42" /><Setter Property="Height" Value="24" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Width="42" Height="24">
                    <Border x:Name="Track" CornerRadius="12" Background="{DynamicResource ToggleTrackBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                    <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="3" HorizontalAlignment="Left" Fill="{DynamicResource ToggleThumbBrush}" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource PurpleBrush}" /><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PurpleBrush}" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.82" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /><Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" /><Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="12" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.76" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.46" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="34" /><Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" /><Setter Property="Padding" Value="10,5" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PurpleBrush}" /><Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="NavigationItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="40" /><Setter Property="Margin" Value="0,2" /><Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid><Border x:Name="Surface" Background="Transparent" CornerRadius="6" />
                    <Border x:Name="Indicator" Width="3" Height="20" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource PurpleBrush}" Opacity="0" />
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" /></Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ButtonBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter TargetName="Indicator" Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource PurpleBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ThemeSegmentStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="34" /><Setter Property="MinWidth" Value="70" /><Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Surface" Margin="2" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PurpleBrush}" /><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource GlassHighlightBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="4" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Height" Value="28" /><Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="2" Background="{DynamicResource BorderBrush}" CornerRadius="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Margin="0" CornerRadius="10" Background="{DynamicResource WindowTintBrush}" BorderBrush="{DynamicResource GlassHighlightBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
            <Rectangle Grid.RowSpan="3" Fill="{StaticResource GlassSheenBrush}" IsHitTestVisible="False" />
            <Border Grid.RowSpan="3" Margin="1" BorderBrush="{DynamicResource GlassHighlightBrush}" BorderThickness="1,1,0,0" CornerRadius="9" IsHitTestVisible="False" />
            <Border Grid.RowSpan="3" Margin="1" BorderBrush="{DynamicResource ShadowBrush}" BorderThickness="0,0,1,1" CornerRadius="9" Opacity="0.42" IsHitTestVisible="False" />
            <Grid Grid.Row="0" Margin="0" Background="{DynamicResource SurfaceElevatedBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="24,0,0,0" VerticalAlignment="Center"><TextBlock Text="设置" FontSize="21" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" /><TextBlock Text="CastoPet 偏好设置" Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Margin="0,0,18,0" Style="{StaticResource CloseButtonStyle}" Content="×" FontSize="20" ToolTip="关闭" Click="CloseButton_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="172" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource NavigationBrush}" BorderBrush="{DynamicResource GlassHighlightBrush}" BorderThickness="0,1,1,0">
                    <StackPanel x:Name="SettingsNavigation" Margin="14,18">
                        <TextBlock Margin="10,0,0,8" Text="设置分类" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <RadioButton GroupName="SettingsView" Style="{StaticResource NavigationItemStyle}" Content="常规" Tag="General" IsChecked="True" Checked="ViewNavigation_Checked" />
                        <RadioButton GroupName="SettingsView" Style="{StaticResource NavigationItemStyle}" Content="快捷启动" Tag="Shortcuts" Checked="ViewNavigation_Checked" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <ScrollViewer x:Name="GeneralView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="22,16,22,18">
                                <TextBlock Text="常规" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Margin="0,4,0,14" Text="调整界面外观、桌宠行为与系统选项" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Border Padding="12,8" Background="{DynamicResource LavenderBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"><TextBlock Text="外观" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource PurpleBrush}" /></Border>
                                <Grid MinHeight="68" Margin="12,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="界面主题" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" /><TextBlock Margin="0,3,0,0" Text="可跟随 Windows，也可固定明暗模式" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel>
                                    <Border Grid.Column="1" Padding="2" VerticalAlignment="Center" Background="{DynamicResource ButtonBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="SystemThemeButton" GroupName="ThemeMode" Tag="System" Content="跟随系统" Style="{StaticResource ThemeSegmentStyle}" Checked="ThemeMode_Checked" />
                                            <RadioButton x:Name="LightThemeButton" GroupName="ThemeMode" Tag="Light" Content="浅色" Style="{StaticResource ThemeSegmentStyle}" Checked="ThemeMode_Checked" />
                                            <RadioButton x:Name="DarkThemeButton" GroupName="ThemeMode" Tag="Dark" Content="深色" Style="{StaticResource ThemeSegmentStyle}" Checked="ThemeMode_Checked" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel x:Name="SettingsItemsHost" />
                                <Border Margin="0,6,0,0" Padding="12,8" Background="{DynamicResource LavenderBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"><TextBlock Text="维护" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource PurpleBrush}" /></Border>
                                <Grid MinHeight="66" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="本地崩溃日志" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" /><TextBlock Margin="0,3,0,0" Text="查看仅保存在此电脑上的异常报告" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel>
                                    <Button x:Name="OpenCrashReportsButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Content="打开目录" Click="OpenCrashReportsButton_Click" />
                                </Grid>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"><Grid MinHeight="84" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="自动更新" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" /><TextBlock x:Name="CurrentVersionText" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock x:Name="UpdateStatusText" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel>
                                    <Button x:Name="CheckForUpdatesButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Content="检查更新" Click="CheckForUpdatesButton_Click" />
                                </Grid></Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid x:Name="ShortcutLauncherView" Margin="22,16,22,18" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="快捷启动" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" /><TextBlock Margin="0,4,0,14" Text="管理拖入桌宠或手动添加的程序、文件和网址" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel>
                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="ShortcutUrlTextBox" Style="{StaticResource InputStyle}" ToolTip="输入 http 或 https 地址" /><Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}" Content="添加网址" Click="AddShortcutUrlButton_Click" /></Grid>
                            <ListView x:Name="ShortcutList" Grid.Row="2" Margin="0,10,0,0" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SelectionChanged="ShortcutList_SelectionChanged">
                                <ListView.View><GridView AllowsColumnReorder="False"><GridViewColumn Header="名称" Width="130" DisplayMemberBinding="{Binding Name}" /><GridViewColumn Header="类型" Width="72" DisplayMemberBinding="{Binding TypeLabel}" /><GridViewColumn Header="目标" Width="300" DisplayMemberBinding="{Binding Target}" /><GridViewColumn Header="状态" Width="62" DisplayMemberBinding="{Binding ValidityLabel}" /></GridView></ListView.View>
                            </ListView>
                            <Grid Grid.Row="3" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="ShortcutUrlErrorText" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="MoveShortcutUpButton" Style="{StaticResource IconButtonStyle}" Content="↑" ToolTip="上移" Click="MoveShortcutUpButton_Click" /><Button x:Name="MoveShortcutDownButton" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" Content="↓" ToolTip="下移" Click="MoveShortcutDownButton_Click" /><Button x:Name="DeleteShortcutButton" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" Content="×" ToolTip="删除" Click="DeleteShortcutButton_Click" /></StackPanel></Grid>
                            <Border Grid.Row="4" Margin="0,10,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="名称" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="ShortcutNameTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" /><Button x:Name="SaveShortcutButton" Grid.Column="2" Grid.RowSpan="3" Margin="10,0,0,0" VerticalAlignment="Bottom" Style="{StaticResource ActionButtonStyle}" Content="保存" Click="SaveShortcutButton_Click" />
                                <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="启动参数" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="ShortcutArgumentsTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource InputStyle}" ToolTip="仅程序可用" />
                                <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Text="工作目录" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBox x:Name="ShortcutWorkingDirectoryTextBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource InputStyle}" ToolTip="仅程序可用" />
                            </Grid></Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource LavenderBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10"><TextBlock Margin="24,0" VerticalAlignment="Center" Text="常规设置立即生效；快捷项编辑后请保存" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" /></Border>
            <Rectangle Grid.RowSpan="3" Fill="{StaticResource FrostedTextureBrush}" Opacity="0.3" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
