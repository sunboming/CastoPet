<Window x:Class="CastoPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CastoPet 设置" Width="680" Height="650" MinWidth="560" MaxWidth="700" MinHeight="560"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        FontFamily="MiSans, Noto Sans SC, Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PurpleBrush" Color="#8C7AA5" />
        <SolidColorBrush x:Key="PurpleHoverBrush" Color="#7E6D97" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FAF9FC" />
        <SolidColorBrush x:Key="LavenderBrush" Color="#F4F1F7" />
        <SolidColorBrush x:Key="DividerBrush" Color="#E7E0EC" />
        <SolidColorBrush x:Key="TextBrush" Color="#35313A" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#7A7480" />

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22">
                            <Border x:Name="Track" CornerRadius="11" Background="#DDD9E1" BorderBrush="#D2CDD6" BorderThickness="1" />
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3" HorizontalAlignment="Left" Fill="White" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#8C7AA5" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#8C7AA5" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#716A78" /><Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" /><Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="#EEE9F2" /><Setter Property="Foreground" Value="#5F5668" />
            <Setter Property="BorderBrush" Value="#DED6E5" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="32" /><Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" /><Setter Property="Padding" Value="9,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="BorderBrush" Value="#DCD4E3" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32" /><Setter Property="MinWidth" Value="96" /><Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EDE8F1" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource PurpleBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="3" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EDE7F2" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="14" CornerRadius="8" Background="{StaticResource SurfaceBrush}" BorderBrush="#E2DCE7" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.16" Color="#51475D" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" /><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="42" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="24,0,16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="设置" FontSize="20" FontWeight="Medium" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="管理桌宠行为与快捷操作" Margin="0,3,0,0" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource CloseButtonStyle}"
                        Content="×" FontSize="20" ToolTip="关闭" Click="CloseButton_Click" />
            </Grid>
            <Border Grid.Row="1" Margin="18,0" Padding="3" Background="{StaticResource LavenderBrush}" CornerRadius="5">
                <StackPanel x:Name="SettingsNavigation" Orientation="Horizontal">
                    <RadioButton GroupName="SettingsView" Style="{StaticResource SegmentStyle}" Content="常规" Tag="General"
                                 IsChecked="True" Checked="ViewNavigation_Checked" />
                    <RadioButton GroupName="SettingsView" Style="{StaticResource SegmentStyle}" Content="快捷启动" Tag="Shortcuts"
                                 Checked="ViewNavigation_Checked" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="GeneralView" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,0,18,12">
                    <StackPanel x:Name="SettingsItemsHost" />
                    <Border Margin="0,6,0,0" Padding="11,7" Background="{StaticResource LavenderBrush}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="维护" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource PurpleBrush}" />
                    </Border>
                    <Grid MinHeight="64" Margin="11,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="本地崩溃日志" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,3,0,0" Text="查看仅保存在此电脑上的异常报告" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Button x:Name="OpenCrashReportsButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}"
                                Content="打开目录" Click="OpenCrashReportsButton_Click" />
                    </Grid>
                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                        <Grid MinHeight="82" Margin="11,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="自动更新" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="CurrentVersionText" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="UpdateStatusText" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button x:Name="CheckForUpdatesButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}"
                                    Content="检查更新" Click="CheckForUpdatesButton_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ShortcutLauncherView" Grid.Row="2" Margin="18,8,18,12" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="ShortcutUrlTextBox" Style="{StaticResource InputStyle}" ToolTip="输入 http 或 https 地址" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ActionButtonStyle}"
                            Content="添加网址" Click="AddShortcutUrlButton_Click" />
                </Grid>
                <ListView x:Name="ShortcutList" Grid.Row="1" Margin="0,10,0,0" Background="White"
                          BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" SelectionChanged="ShortcutList_SelectionChanged">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="名称" Width="130" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="类型" Width="72" DisplayMemberBinding="{Binding TypeLabel}" />
                            <GridViewColumn Header="目标" Width="300" DisplayMemberBinding="{Binding Target}" />
                            <GridViewColumn Header="状态" Width="62" DisplayMemberBinding="{Binding ValidityLabel}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <Grid Grid.Row="2" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ShortcutUrlErrorText" VerticalAlignment="Center" FontSize="11" Foreground="#A14F62" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="MoveShortcutUpButton" Style="{StaticResource IconButtonStyle}" Content="↑" ToolTip="上移" Click="MoveShortcutUpButton_Click" />
                        <Button x:Name="MoveShortcutDownButton" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" Content="↓" ToolTip="下移" Click="MoveShortcutDownButton_Click" />
                        <Button x:Name="DeleteShortcutButton" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" Content="×" ToolTip="删除" Click="DeleteShortcutButton_Click" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="名称" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="ShortcutNameTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" />
                        <Button x:Name="SaveShortcutButton" Grid.Column="2" Grid.RowSpan="3" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                Style="{StaticResource ActionButtonStyle}" Content="保存" Click="SaveShortcutButton_Click" />
                        <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="启动参数" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="ShortcutArgumentsTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource InputStyle}" ToolTip="仅程序可用" />
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Text="工作目录" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBox x:Name="ShortcutWorkingDirectoryTextBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource InputStyle}" ToolTip="仅程序可用" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource LavenderBrush}" BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                <TextBlock Margin="24,0" VerticalAlignment="Center" Text="更改将立即生效并自动保存"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
            </Border>
        </Grid>
    </Border>
</Window>
